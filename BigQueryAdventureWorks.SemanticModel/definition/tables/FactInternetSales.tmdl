table FactInternetSales
	lineageTag: 113dcea1-817a-4cc7-bdb6-d5fa9518df65

	measure 'Total Sales' = SUMX (FactInternetSales, FactInternetSales[UnitPrice] * FactInternetSales[SalesAmount])
		lineageTag: 97595e96-03d2-48b3-9a95-a2dfba303955

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales Red' = ```
			CALCULATE(
			                            [Total Sales],
			                             DimProduct[Color] = "Red"
			                    )
			
			```
		lineageTag: b5fcf90d-3faf-46d0-a849-71b7dfbb11ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales Red BAD' =
			SUMX(
			                            FactInternetSales,
			                            IF (
			                                RELATED(DimProduct[Color]) = "Red",
			                                CALCULATE([Total Sales]
			                            )
			                    ))
		lineageTag: e81049f3-75cb-49bc-a0a3-deafa781e1de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

